  "key_design_decisions": [
    {
      "decision": "Neurodivergent-affirming language throughout AI agents",
      "rationale": "Avoid functioning labels, use strengths-first framing, respect neurodiversity principles"
    },
    {
      "decision": "Learner pseudonymization by default",
      "rationale": "Privacy-first: children's real identities never enter the system"
    },
    {
      "decision": "Supervisor-Worker agent pattern",
      "rationale": "Enables domain-specific expert agents without a monolithic model. Groq used for cheap routing, Gemini for quality generation."
    },
    {
      "decision": "Lazy initialization of PDF/embedding models",
      "rationale": "Avoids 30–60 second startup delay; models load on first RAG request only"
    },
    {
      "decision": "Graceful degradation on missing API keys",
      "rationale": "All OAuth providers and LLM providers show clear error messages rather than crashing the service"
    },
    {
      "decision": "JSONB columns for sensory logs and progress data",
      "rationale": "Flexible schema for evolving learner data structures without repeated migrations"
    },
    {
      "decision": "Two-layer guardrails (API entry + router)",
      "rationale": "Defense in depth — malicious inputs blocked before reaching any LLM"
    },
    {
      "decision": "thread_id-based conversation persistence in SQLite",
      "rationale": "Enables multi-turn Thandi conversations without storing sensitive data in PostgreSQL"
    },
    {
      "decision": "Next.js proxies /api/agent/chat to FastAPI",
      "rationale": "Avoids exposing the Python service port directly to browsers; single origin for frontend"
    },
    {
      "decision": "School → Class → Learner hierarchy",
      "rationale": "Multi-tenancy ready: supports future school accounts and class-level admin management"
    }
  ],

