# ─── Backend (apps/backend/) ────────────────────────────────────────────────
PORT=5000

# Database — use DATABASE_URL for a connection string OR the individual vars below
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=allminds_db

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Email (optional — password reset emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@allminds.org

# OAuth (optional — configure only the providers you want)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
APPLE_CLIENT_ID=your_apple_service_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# ─── Service URLs ────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_API_URL=http://localhost:5000/api

# URL of the FastAPI agent service — used by the Next.js proxy route
AGENTIC_AI_URL=http://127.0.0.1:8000

# CORS — comma-separated origins allowed by backend and agent service
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_TIMEZONE=Africa/Johannesburg

# ─── Agent service (apps/agents/) ───────────────────────────────────────────
# Both keys are required — Groq for routing, Gemini for generation
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_API_KEY=your_youtube_api_key
